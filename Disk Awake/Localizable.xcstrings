    },
    "Keep Mac Awake" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ máy Mac hoạt động"
          }
        }
      }
    },
    "Keep Mac Awake for Jellyfin" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ máy Mac hoạt động cho Jellyfin"
          }
        }
      }
    },
    "Keeping Mac awake for Jellyfin — 15-minute grace period" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đang giữ máy Mac hoạt động cho Jellyfin – thời gian chờ 15 phút"
          }
        }
      }
    },
    "Keeps the Mac awake for 15 minutes after waking and while TCP port 8096 has established connections. Allows sleep 15 minutes after the last connection. If connection detection fails, keeps the Mac awake until detection recovers or you turn this off. Dark Wake requires AC power and Wake for network access." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Giữ máy Mac hoạt động trong 15 phút sau khi thức dậy và khi cổng TCP 8096 có các kết nối đã thiết lập. Cho phép máy chuyển sang chế độ ngủ 15 phút sau khi kết nối cuối cùng kết thúc. Nếu không thể phát hiện kết nối, máy Mac sẽ tiếp tục hoạt động cho đến khi tính năng phát hiện khôi phục hoặc bạn tắt tùy chọn này. Dark Wake yêu cầu nguồn điện AC và tính năng Đánh thức để truy cập mạng."
          }
        }
      }
    },
    "No external drives" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có ổ đĩa ngoài"
          }
        }
      }
    },
    "No Jellyfin connections — system sleep allowed" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Không có kết nối Jellyfin – hệ thống có thể chuyển sang chế độ ngủ"
          }
        }
      }
    },
    "Paused" : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Đã tạm dừng"
          }
        }
      }
    },
    "Prevents automatic system sleep while this app is running. The display can still sleep, and you can still put your Mac to sleep manually." : {
      "localizations" : {
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Ngăn hệ thống tự động chuyển sang chế độ ngủ khi ứng dụng này đang chạy. Màn hình vẫn có thể ngủ và bạn vẫn có thể đưa máy Mac vào chế độ ngủ theo cách thủ công."
          }
        }
      }
    },
